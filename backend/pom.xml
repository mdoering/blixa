<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.0</version>
    <relativePath/>
  </parent>

  <groupId>org.catalogueoflife</groupId>
  <artifactId>blixa-backend</artifactId>
  <version>0.1.0-SNAPSHOT</version>

  <properties>
    <java.version>25</java.version>
    <mybatis-starter.version>4.0.1</mybatis-starter.version>
    <clb.version>1.7.0-SNAPSHOT</clb.version>
  </properties>

  <!-- The CLB modules and the name parser pair they are built with come from the backend's BOM, so moving to another
       backend version is this one property. It manages CoL and name parser artifacts only, nothing Spring Boot does. -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.catalogueoflife</groupId>
        <artifactId>clb-bom</artifactId>
        <version>${clb.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Official Anthropic Java SDK for the AI-assisted curation feature's Claude adapter. -->
    <dependency>
      <groupId>com.anthropic</groupId>
      <artifactId>anthropic-java</artifactId>
      <version>2.34.0</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-client</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-mail</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-security-test</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.mybatis.spring.boot</groupId>
      <artifactId>mybatis-spring-boot-starter</artifactId>
      <version>${mybatis-starter.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <!-- Was scope=runtime (only the JDBC driver, loaded reflectively, was needed); now also
         referenced directly at compile time by IdentifierScopeListTypeHandler for
         org.postgresql.util.PGobject (JSONB parameter binding), so the default (compile)
         scope is required. -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- GBIF name parser 5.x: the API module (NameParser interface, ParseResult, enums like
         Rank/NomCode/NameType) is separate from the implementation. The reference Java impl
         (NameParserImpl) was dropped at 5.0.0; the sole implementation is now a Rust core reached
         over the JDK Foreign Function and Memory API (java.lang.foreign), which requires JDK 25.
         Their versions come from clb-bom, the pair the CLB backend is built with. -->
    <dependency>
      <groupId>org.gbif</groupId>
      <artifactId>name-parser-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.gbif.nameparser</groupId>
      <artifactId>name-parser-rust</artifactId>
    </dependency>
    <!-- Native FFI libraries, one classifier jar per platform. Both are bundled so the SAME
         fat jar runs on the deploy/CI host (Linux x86_64) and local dev (macOS Apple Silicon);
         NameParserRust extracts and loads whichever matches the running os+arch at startup. Add a
         classifier here if the parser must run on another platform (e.g. osx-x86_64, linux-aarch_64). -->
    <dependency>
      <groupId>org.gbif.nameparser</groupId>
      <artifactId>name-parser-rust</artifactId>
      <classifier>linux-x86_64</classifier>
    </dependency>
    <dependency>
      <groupId>org.gbif.nameparser</groupId>
      <artifactId>name-parser-rust</artifactId>
      <classifier>osx-aarch_64</classifier>
    </dependency>
    <dependency>
      <groupId>org.gbif</groupId>
      <artifactId>text-tree</artifactId>
      <version>1.7.0</version>
    </dependency>
    <dependency>
      <groupId>org.catalogueoflife</groupId>
      <artifactId>vocab</artifactId>
    </dependency>
    <!-- ColDP io (ColdpTerm, ColdpReader, TabWriter); pulls in the CLB `api` module
         (Jackson 2 `com.fasterxml`, guava, commons, httpclient5, mapdb, kryo, fastutil) -
         coexists with our Jackson 3 (`tools.jackson`) stack since the packages differ. -->
    <dependency>
      <groupId>org.catalogueoflife</groupId>
      <artifactId>reader</artifactId>
    </dependency>
    <!-- CslFormatter/CslData (life.catalogue.common.csl / life.catalogue.api.model), same
         org.catalogueoflife:api transitive (already pulled in by `reader` above) that provides the
         bundled /csl-styles/*.csl resources CslFormatter loads off the classpath. Used by
         name/ReferenceCitationService to generate reference citations (see V25__project_csl_style.sql). -->
    <dependency>
      <groupId>org.catalogueoflife</groupId>
      <artifactId>reference</artifactId>
    </dependency>
    <!-- CLB nomenclature module: name relation / homotypic grouping logic over life.catalogue.api.model.Name. -->
    <dependency>
      <groupId>org.catalogueoflife</groupId>
      <artifactId>nomenclature</artifactId>
      <exclusions>
        <!-- its transitive rust binding carries an unresolved ${os.detected.classifier}; we declare the per-platform jars ourselves above -->
        <exclusion><groupId>org.gbif.nameparser</groupId><artifactId>name-parser-rust</artifactId></exclusion>
      </exclusions>
    </dependency>
    <!-- BibTeX parsing for reference import (see name/RefMapping.fromBibtex). -->
    <dependency>
      <groupId>org.jbibtex</groupId>
      <artifactId>jbibtex</artifactId>
      <version>1.0.20</version>
    </dependency>
    <!-- Darwin Core Archive reading (DwcFiles/Archive/StarRecord) for coldp/imprt DwC-A import;
         org.gbif:dwc-api (the Term vocab) is already pulled in transitively. -->
    <dependency>
      <groupId>org.gbif</groupId>
      <artifactId>dwca-io</artifactId>
      <version>3.0.0</version>
    </dependency>
  </dependencies>

  <repositories>
    <repository>
      <id>gbif-releases</id>
      <url>https://repository.gbif.org/repository/releases/</url>
    </repository>
    <repository>
      <id>gbif-snapshot</id>
      <snapshots><enabled>true</enabled></snapshots>
      <url>https://repository-snapshots.gbif.org/repository/snapshots/</url>
    </repository>
  </repositories>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <parameters>true</parameters>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
